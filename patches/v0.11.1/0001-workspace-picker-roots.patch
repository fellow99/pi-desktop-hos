+
+// ---------------------------------------------------------------------------
+// pi-desktop-hos — 需求 203-plugin-workspace-picker（本段为下游新增，上游无对应物）
+//
+// 四个工作区主目录（沙箱 / 桌面 / 文档 / 下载）由壳的**主进程**解析并写入环境变量
+// PI_HOS_ROOTS（`src-main/main.js#installWorkspaceRoots`）。这里只**消费**它：
+//   · 缺失 / 非法 / 空 → 返回空数组，调用方按「无主目录」降级，**不猜测路径**；
+//   · 本模块不写回、不缓存到磁盘，主进程始终是唯一真值来源。
+// 主目录集合与对话框的 Tab 顺序以该数组顺序为准。
+// ---------------------------------------------------------------------------
+
+/** 主进程注入的根清单环境变量名（与脚本/文档同名字面量）。 */
+export const WORKSPACE_ROOTS_ENV = "PI_HOS_ROOTS";
+
+/** 单个工作区主目录。`permType` 为 null 表示该根无 OS 级权限门槛（沙箱）。 */
+export interface WorkspaceRoot {
+  id: string;
+  label: string;
+  path: string;
+  permType: string | null;
+}
+
+/** 单列列表的条目上限；触顶时由调用方展示 truncated 提示，不静默截断。 */
+export const DIRECTORY_ENTRY_LIMIT = 1000;
+
+/** 以 `.` 开头的条目视为隐藏项，对话框不渲染。 */
+export function isHiddenName(name: string): boolean {
+  return name.startsWith(".");
+}
+
+/** 读取壳注入的工作区主目录清单。任何异常都退化为空数组。 */
+export function getWorkspaceRoots(): WorkspaceRoot[] {
+  const raw = process.env[WORKSPACE_ROOTS_ENV];
+  if (!raw) return [];
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) return [];
+    return parsed
+      .filter((root): root is Record<string, unknown> => Boolean(root) && typeof root === "object")
+      .map((root) => ({
+        id: typeof root.id === "string" ? root.id : "",
+        label: typeof root.label === "string" && root.label ? root.label : String(root.id ?? ""),
+        path: typeof root.path === "string" ? root.path : "",
+        permType: typeof root.permType === "string" && root.permType ? root.permType : null,
+      }))
+      .filter((root) => root.id.length > 0 && root.path.length > 0);
+  } catch {
+    return [];
+  }
+}
+
+/** 按 id 取主目录；未知 id 返回 null（调用方必须报错，不得回退到别的根）。 */
+export function resolveWorkspaceRoot(rootId: string): WorkspaceRoot | null {
+  return getWorkspaceRoots().find((root) => root.id === rootId) ?? null;
+}
+
+/**
+ * 词法「在根之内」判定：相等，或以 `根 + 分隔符` 为前缀（带分隔符边界，避免 `/a/bc` 命中 `/a/b`）。
+ * 根围栏的可复用原语 —— GET 列目录与 POST 建目录共用同一判定。
+ */
+export function isPathInsideRoot(rootPath: string, targetPath: string): boolean {
+  // 分隔符必须**两种都认**，不能只看 path.sep：目标平台（HarmonyOS）给的是一律以 `/` 分隔的
+  // 绝对路径，而本模块也会在 Windows 构建机上被加载（补丁的单元测试、脚本）。用 path.sep 时
+  // 在 Windows 上会拿到 ``，于是 `/a/b/c` 不再被判为在 `/a/b` 之内 —— 围栏会静默放宽。
+  const root = rootPath.replace(/[\/]+$/, "");
+  if (!root) return false;
+  if (targetPath === root) return true;
+  return targetPath.startsWith(root + "/") || targetPath.startsWith(root + "\\");
+}
+export interface WorkspaceListing {
+  rootId: string;
+  rootPath: string;
+  path: string;
+  entries: BrowsableDirectory[];
+  truncated: boolean;
+}
+
+/**
+ * 列出一个工作区主目录（或它的某个子目录）。
+ *
+ * 只在**该主目录之内**取子路径：`requestedPath` 为空则列主目录根；否则必须
+ * 以主目录根为前缀（词法前缀 + 分隔符边界），越界一律拒绝。这是根围栏的
+ * 服务端一侧 —— 对话框不提供手输路径入口，服务端也不接受越界路径。
+ */
+export async function listWorkspaceEntries(
+  root: WorkspaceRoot,
+  requestedPath?: string,
+): Promise<WorkspaceListing> {
+  const rootPath = await resolveDirectory(root.path).catch(() => path.resolve(root.path));
+  let target = rootPath;
+
+  if (requestedPath) {
+    const normalized = await resolveDirectory(requestedPath).catch(() => null);
+    if (!normalized) throw new Error("Directory does not exist");
+    if (!isPathInsideRoot(rootPath, normalized)) {
+      throw new Error("Path is outside the selected workspace root");
+    }
+    target = normalized;
+  }
+
+  const all = await listDirectories(target);
+  const visible = all.filter((entry) => !isHiddenName(entry.name));
+  return {
+    rootId: root.id,
+    rootPath,
+    path: target,
+    entries: visible.slice(0, DIRECTORY_ENTRY_LIMIT),
+    truncated: visible.length > DIRECTORY_ENTRY_LIMIT,
+  };
+}
