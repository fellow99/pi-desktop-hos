{
  "module": {
    "name": "web_engine",
    "type": "har",
    "deviceTypes": [
      "tablet",
      "2in1"
    ],
    // ── 权限表定制（相对上游 harmonypc-electron/ohos_hap/web_engine/src/main/module.json5）──
    // 上游原有、本工程**删除**的权限（其依赖的 adapter/jsbindings 同步剪裁，见 runtime-overlays/README.md
    // 的 PRUNE_FILES）：CAMERA / MICROPHONE / LOCATION / APPROXIMATELY_LOCATION /
    // LOCATION_IN_BACKGROUND / ACCESS_BLUETOOTH / DISTRIBUTED_DATASYNC / WEB_NATIVE_MESSAGING。
    //   理由：本桌面壳不提供相机、麦克风、定位、蓝牙、分布式数据同步能力，声明了也用不上，只会扩大
    //   上架审核面（应用市场按权限逐条核对申请说明）。
    // 上游原有、本工程**保留**的权限：INTERNET / GET_NETWORK_INFO / ACCESS_CERT_MANAGER /
    //   RUNNING_LOCK / PRINT / PREPARE_APP_TERMINATE / ACCESS_BIOMETRIC / FILE_ACCESS_PERSIST /
    //   PRIVACY_WINDOW / WINDOW_TOPMOST / kernel.ALLOW_WRITABLE_CODE_MEMORY（Electron 运行时 JIT 必需）/
    //   GYROSCOPE / ACCELEROMETER / GET_FILE_ICON / LOCK_WINDOW_CURSOR / READ_PASTEBOARD /
    //   READ_WRITE_{DOWNLOAD,DOCUMENTS,DESKTOP}_DIRECTORY / CUSTOM_SCREEN_CAPTURE；
    //   其中 usedScene 由上游示例工程的 FormAbility/always 改为本工程入口 EntryAbility/inuse。
    // 本工程（App 级）**新增**的权限共 3 条，均在下方逐条标注。
    // 市场说明：上游权限表中没有「市场/pnpm 供给」专用权限（本工程也无该步骤，见 docs/工程规划.md §6.3），
    // 故除上列 8 条外未再删除任何条目。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.ACCESS_CERT_MANAGER"
      },
      {
        "name": "ohos.permission.RUNNING_LOCK"
      },
      {
        "name": "ohos.permission.PRINT"
      },
      {
        "name": "ohos.permission.PREPARE_APP_TERMINATE"
      },
      {
        "name": "ohos.permission.ACCESS_BIOMETRIC"
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.PRIVACY_WINDOW"
      },
      {
        "name": "ohos.permission.WINDOW_TOPMOST"
      },
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      },
      // App 级新增权限 1/3（上游不存在）：随包 Node 运行时继承父进程权限。
      {
        "name": "ohos.permission.INHERIT_PARENT_PERMISSION",
        "reason": "$string:inherit_parent_permission",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      },
      // App 级新增权限 2/3（上游不存在）：加载随包签名的原生库时跳过库校验（Electron 原生件不在系统校验名单内）。
      {
        "name": "ohos.permission.kernel.IGNORE_LIBRARY_VALIDATION",
        "reason": "$string:ignore_library_validation",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      },
      // App 级新增权限 3/3（上游不存在）：允许随包 Node/Electron 运行时申请匿名可执行内存（V8 JIT 必需）。
      {
        "name": "ohos.permission.kernel.EXEMPT_ANONYMOUS_EXECUTABLE_MEMORY",
        "reason": "$string:exempt_anonymous_executable_memory",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      },
      {
        "name": "ohos.permission.GYROSCOPE"
      },
      {
        "name": "ohos.permission.ACCELEROMETER"
      },
      {
        "name": "ohos.permission.GET_FILE_ICON"
      },
      {
        "name": "ohos.permission.LOCK_WINDOW_CURSOR"
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:access_pasteboard",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_dir",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:documents_dir",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DESKTOP_DIRECTORY",
        "reason": "$string:desktop_dir",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      },
      {
        "name": "ohos.permission.CUSTOM_SCREEN_CAPTURE",
        "reason": "$string:screen_capture",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when":"inuse"
        }
      }
    ],
    "definePermissions": [
      {
        "name": "ohos.permission.LOCK_WINDOW_CURSOR"
      },
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      }
    ]
  }
}
