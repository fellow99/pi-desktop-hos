index 0000000..a8f08e5
--- /dev/null
+++ b/app/api/cwd/workspace-permission/route.ts
@@ -0,0 +1,86 @@
+import { NextResponse } from "next/server";
+import { getWorkspaceRoots } from "@/lib/directory-browser";
+import { hasJsonContentType, isApiRequestAllowed } from "@/lib/request-security";
+
+/**
+ * pi-desktop-hos — 203-plugin-workspace-picker（本文件为下游新增，上游无对应物）
+ *
+ * 「选择工作区目录」对话框在遇到 EACCES/EPERM 时的**权限预检**与**去系统设置**入口。
+ *
+ * 为什么需要这条路由：权限能力（`electron.systemPreferences.checkPermission` /
+ * `openApplicationInfoEntry`）只存在于**主进程**；本 Next 服务器与主进程同进程，
+ * 由壳的 `src-main/main.js#installPermissionBridge` 挂在 `globalThis.__PI_HOS_PERMISSION__`。
+ * 渲染进程读不到它，所以这里做一层**同源**转发。
+ *
+ * 边界：只暴露两个动作（只读预检 / 跳系统设置），不承载任何业务数据，不写文件，
+ * 不接受入参中的任意权限名（只接受壳声明的四个 root id 对应的 permType）。
+ */
+
+interface PermissionBridge {
+  available: boolean;
+  check?: (permType: string) => boolean | undefined;
+  openAppInfo?: () => boolean;
+}
+
+function bridge(): PermissionBridge | null {
+  const candidate = (globalThis as Record<string, unknown>).__PI_HOS_PERMISSION__;
+  if (!candidate || typeof candidate !== "object") return null;
+  return candidate as PermissionBridge;
+}
+
+/** 只接受壳在 PI_HOS_ROOTS 里声明过的 permType —— 其它一律忽略（不做任意权限探测）。 */
+function declaredPermTypes(): Set<string> {
+  return new Set(
+    getWorkspaceRoots()
+      .map((root) => root.permType)
+      .filter((permType): permType is string => Boolean(permType)),
+  );
+}
+
+// GET /api/cwd/workspace-permission -> { available, grants: { [permType]: boolean|null } }
+export async function GET() {
+  const b = bridge();
+  const available = Boolean(b && b.available === true && typeof b.check === "function");
+  const grants: Record<string, boolean | null> = {};
+  for (const permType of declaredPermTypes()) {
+    // null = 不可判定；客户端据此显示「不可判定」而不是把它当作「未授权」。
+    grants[permType] = available ? b!.check!(permType) ?? null : null;
+  }
+  return NextResponse.json({ available, grants });
+}
+
+// POST /api/cwd/workspace-permission  body: { action: "openAppInfo" }
+export async function POST(request: Request) {
+  // 与 app/api/cwd/browse 的同源写接口保持同一套前置校验（proxy.ts 已做 host/origin + 口令，
+  // 这里是路由层的纵深防御与一致性）。
+  if (!isApiRequestAllowed(request)) {
+    return NextResponse.json({ error: "Untrusted API request" }, { status: 403 });
+  }
+  if (!hasJsonContentType(request)) {
+    return NextResponse.json({ error: "Content-Type must be application/json" }, { status: 415 });
+  }
+
+  let body: { action?: unknown };
+  try {
+    body = await request.json() as { action?: unknown };
+  } catch {
+    return NextResponse.json({ error: "Body must be JSON" }, { status: 400 });
+  }
+
+  if (body.action !== "openAppInfo") {
+    return NextResponse.json({ error: "Unsupported action" }, { status: 400 });
+  }
+
+  const b = bridge();
+  if (!b || typeof b.openAppInfo !== "function") {
+    // fail-visible：桥不可用时明确失败，让对话框给出归因，绝不假装成功。
+    return NextResponse.json({ error: "Permission bridge is unavailable", available: false }, { status: 503 });
+  }
+
+  try {
+    const ok = b.openAppInfo();
+    return NextResponse.json({ ok: ok === true });
+  } catch (error) {
+    return NextResponse.json({ error: String(error) }, { status: 500 });
+  }
+}
